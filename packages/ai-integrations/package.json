{
  "name": "@mstack/ai-integrations",
  "version": "0.7.0",
  "private": true,
  "description": "Adapters that carry the Build Like This workflow into AI coding environments",
  "author": "Misbah Khursheed",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "sync-runtime-templates": "node scripts/sync-runtime-templates.mjs",
    "prebuild": "pnpm run sync-runtime-templates",
    "build": "tsc -p tsconfig.json",
    "typecheck": "pnpm run sync-runtime-templates && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/test/*.test.js"
  }
}
